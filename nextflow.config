/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/easi Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

nextflow.enable.moduleBinaries = true

// Global default params, used in configs
params {

    // Input options
    input                      = 'tests/data/samplesheet.csv'

    // References
    genome                     = null
    igenomes_base              = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore            = false
    star_index                 = null
    gtf                        = null
    star_readfiles_command     = 'zcat'

    // Analysis mode
    mode = 'differential'

    // Analysis selection
    run_expression             = 'true'
    run_splicing               = 'true'

    // Differential comparison
    contrast_variable          = 'condition'
    contrast_reference         = null
    contrast_target            = null
    contrast_name              = null

    // DESeq2 options
    gene_id_col                = 'Geneid'
    sample_id_col              = 'sample'
    deseq2_formula             = '~ condition'
    deseq2_comparison          = null
    organism                   = 'human'

    // Splicing-method selection
    run_majiq                  = 'true'
    run_rmats                  = 'true'
    run_leafcutter             = 'true'
    run_isa                    = 'false'

    // MAJIQ options
    majiq_env                  = null
    majiq_license_file         = null

    // rMATS options
    rmats_splice_diff_cutoff   = 0.0001
    rmats_paired_stats         = false
    rmats_read_len             = 40
    rmats_novel_splice_site    = false
    rmats_min_intron_len       = 50
    rmats_max_exon_len         = 500

    // LeafCutter options
    leafcutter_min_cluster_reads = 50
    leafcutter_max_intron_length = 500000

    // IsoformSwitchAnalyzeR options
    fasta                      = null
    transcript_fasta           = null
    isa_gtf                    = null
    pfam_hmm                   = null
    pfam_clans                 = null
    isa_alpha                  = 0.05
    isa_dif_cutoff             = 0.1

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = 'results'
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {

    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }

    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }

    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    docker {
        docker.enabled          = true
        conda.enabled           = false
        wave.enabled            = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }

    arm64 {
        process.arch            = 'arm64'

        // TODO https://github.com/nf-core/modules/issues/6694
        // For now, arm64 requires Wave for the sake of the maintainers.
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }

    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }

    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }

    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }

    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }

    test {
        includeConfig 'conf/test.config'
    }

    test_full {
        includeConfig 'conf/test_full.config'
    }
}

// Load nf-core custom profiles from different institutions
includeConfig params.custom_config_base &&
    (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http'))
    ? "${params.custom_config_base}/nfcore_custom.config"
    : '/dev/null'

// TODO nf-core: Optionally add a pipeline-specific nf-core config.
// includeConfig params.custom_config_base &&
//     (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http'))
//     ? "${params.custom_config_base}/pipeline/easi.config"
//     : '/dev/null'

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Load igenomes.config if required
includeConfig !params.igenomes_ignore
    ? 'conf/igenomes.config'
    : 'conf/igenomes_ignored.config'

// Export variables to prevent local Python/R libraries from conflicting
// with libraries inside containers.
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = '/.Rprofile'
    R_ENVIRON_USER   = '/.Renviron'
    JULIA_DEPOT_PATH = '/usr/local/share/julia'
}

// Set bash options
process.shell = [
    'bash',
    '-C',         // No clobber
    '-e',         // Exit if a command fails
    '-u',         // Treat unset variables as errors
    '-o',
    'pipefail'
]

// Disable process-selector warnings by default.
// The debug profile enables validation.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'nf-core/easi'

    contributors    = [
        [
            name         : 'Vanessa Todorow',
            affiliation  : 'Francis Crick Institute',
            email        : '',
            github       : 'vantsch',
            contribution : [],
            orcid        : ''
        ]
    ]

    homePage        = 'https://github.com/nf-core/easi'

    description     = """
        EASI (Expression and Splicing Integration) is a Nextflow pipeline for
        reproducible analysis of bulk RNA-seq data with a focus on integrating
        gene expression and splicing events. The workflow supports quality
        control, preprocessing, alignment, quantification, differential
        expression, and splicing-aware analyses, enabling users to jointly
        explore transcriptome-wide changes in expression and alternative
        splicing.
    """.stripIndent().trim()

    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1'
}

validation {
    defaultIgnoreParams = ['genomes']
    monochromeLogs      = params.monochrome_logs
}

// Load modules.config for DSL2 module-specific options
includeConfig 'conf/modules.config'