/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    NEMO/Crick cluster config for EASI
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor = 'slurm'
    queue    = 'ncpu'

    withName: 'STAR_ALIGN' {
        cpus   = 12
        memory = '48 GB'
        time   = '12h'
    }

    withName: 'SUBREAD_FEATURECOUNTS' {
        cpus   = 4
        memory = '8 GB'
        time   = '4h'
    }

    withName: 'RMATS_RUN' {
        cpus   = 12
        memory = '64 GB'
        time   = '24h'
    }

    withName: 'RMATS_SUMMARIZE' {
        cpus   = 12
        memory = '64 GB'
        time   = '24h'
    }

    withName: 'MAJIQ_BUILDGFF3|MAJIQ_BUILDSJ|MAJIQ_BUILDUPDATE' {
        cpus   = 12
        memory = '48 GB'
        time   = '12h'
    }

    withName: 'MAJIQ_PSICOVERAGE|MAJIQ_SGCOVERAGE' {
        cpus   = 8
        memory = '32 GB'
        time   = '12h'
    }

    withName: 'MAJIQ_QUANTIFY' {
        cpus   = 8
        memory = '32 GB'
        time   = '12h'
    }

    withName: 'MAJIQ_DELTAPSI' {
        cpus   = 8
        memory = '32 GB'
        time   = '12h'
    }

    withName: 'MAJIQ_HETEROGEN' {
        cpus   = 4
        memory = '32 GB'
        time   = '12h'
    }

    withName: 'MAJIQ_MODULIZE' {
        cpus   = 4
        memory = '32 GB'
        time   = '12h'
    }

    withName: 'QUANTIFY_MODULIZE' {
        cpus   = 4
    	memory = '32 GB'
    	time   = '12h'
    }

    withName: 'DELTAPSI_MODULIZE' {
        cpus   = 4
        memory = '256 GB'
        time   = '12h'
    }

    withName: 'HETEROGEN_MODULIZE' {
    	cpus   = 4
    	memory = '32 GB'
    	time   = '12h'
    }

    withName: 'MAJIQ_SUMMARIZE' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    withName: 'DESEQ2_DIFFERENTIAL' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    withName: 'LEAFCUTTER_CLUSTER|LEAFCUTTER_DS|LEAFCUTTER_DOWNSTREAM' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    withName: 'REGTOOLS_JUNCTIONSEXTRACT' {
        cpus   = 4
        memory = '8 GB'
        time   = '4h'
    }

    withName: 'SALMON_QUANT' {
        cpus   = 8
        memory = '32 GB'
        time   = '12h'
    }

    withName: 'RSEQC_INFEREXPERIMENT' {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }
}

executor {
    queueSize    = 100
    pollInterval = '1 min'
}
