/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FASTQC_RAW' {
        ext.args = '--quiet'
    }

    withName: 'FASTQC_TRIMMED' {
        ext.args = '--quiet'
    }

    withName: 'STAR_ALIGN' {
    cpus = 8
    memory = '40 GB'

    ext.args = "--outSAMtype BAM SortedByCoordinate --outSAMstrandField intronMotif --outSAMattributes NH HI AS nM XS --twopassMode Basic --readFilesCommand zcat"
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SUBREAD_FEATURECOUNTS' {
        cpus = 4
        memory = '8 GB'
        ext.args = "-t exon -g gene_id"
    }

    withName: 'DESEQ2_DIFFERENTIAL' {
        ext.args = "--gene_id_col ${params.gene_id_col} --sample_id_col ${params.sample_id_col} --vst_nsub 100 --organism ${params.organism}"
    }

    
    withName: /^MAJIQ_.*/ {
        container = null

        beforeScript = {
            def majiqEnv = params.majiq_env ?: ''
            def licenseFile = params.majiq_license_file ?: ''

            """
            if [[ -z "${majiqEnv}" ]]; then
                echo "ERROR: --majiq_env is required when MAJIQ is enabled." >&2
                exit 1
            fi

            if [[ ! -x "${majiqEnv}/bin/majiq" ]]; then
                echo "ERROR: MAJIQ executable not found:" >&2
                echo "       ${majiqEnv}/bin/majiq" >&2
                exit 1
            fi

            if [[ -z "${licenseFile}" ]]; then
                echo "ERROR: --majiq_license_file is required when MAJIQ is enabled." >&2
                exit 1
            fi

            if [[ ! -r "${licenseFile}" ]]; then
                echo "ERROR: MAJIQ licence is not readable:" >&2
                echo "       ${licenseFile}" >&2
                exit 1
            fi

            export PATH="${majiqEnv}/bin:\$PATH"
            export MAJIQ_LICENSE_FILE="${licenseFile}"
            """
        }
    }

    withName: 'MAJIQ_DELTAPSI' {
        ext.changing_threshold = 0.1
    }

    withName: 'QUANTIFY_MODULIZE' {
        container = null
        ext.prefix = 'modulize_quantify'
        cpus = 4
        memory = '16 GB'
        time = '4h'

        publishDir = [
            path: { "${params.outdir}/majiq/quantify" },
            mode: params.publish_dir_mode,
            overwrite: true
        ]
    }

    withName: 'DELTAPSI_MODULIZE' {
        container = null
        ext.prefix = 'modulize_deltapsi'
        ext.args = '--changing-between-group-dpsi 0.1'
        cpus = 4
        memory = '16 GB'
        time = '4h'
        publishDir = [
            path: { "${params.outdir}/majiq/deltapsi" },
            mode: params.publish_dir_mode,
            overwrite: true
        ]
    }

    withName: 'HETEROGEN_MODULIZE' {
        container = null
        ext.prefix = 'modulize_heterogen'
        cpus = 4
        memory = '16 GB'
        time = '4h'
        publishDir = [
            path: { "${params.outdir}/majiq/heterogen" },
            mode: params.publish_dir_mode,
            overwrite: true
        ]
    }

    withName: 'MAJIQ_SUMMARIZE' {
        container = 'community.wave.seqera.io/library/pip_openpyxl_pandas:6a8c6a3118605483'
        publishDir = [
            path: { "${params.outdir}/majiq/deltapsi" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename == 'versions.yml' ? null : filename
            }
        ]
    }

    withName: 'LEAFCUTTER_CLUSTER' {
        ext.args = "-m ${params.leafcutter_min_cluster_reads} -l ${params.leafcutter_max_intron_length}"
    }

    withName: 'LEAFCUTTER_DS' {
        ext.args = '-i 3'
    }

    withName: 'RMATS_RUN' {
        cpus = 8
        memory = '40 GB'
    }

    withName: 'RMATS_SUMMARIZE' {
        cpus = 8
        memory = '40 GB'
    }

    withName: 'SALMON_INDEX' {
        ext.args = '--keepDuplicates'
    }
}
